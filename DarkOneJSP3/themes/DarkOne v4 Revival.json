{
  "format": "DarkOneJSP3 Theme",
  "formatVersion": 1,
  "name": "DarkOne v4 Revival",
  "description": "DarkOne v4 style adapted for DarkOneJSP3.",
  "author": "DeViLhoOD",
  "appearance": {
    "palette": {
      "pageBackground": "#FF181818",
      "text": "#FFDCDCDC",
      "accent": "#FF6DB7E2",
      "selected": "#FF303030",
      "divider": "#FF000000",
      "volumeIndicator": "#FFDCDCDC"
    },
    "typography": {
      "controlFamily": "Arial Black",
      "controlWeight": 900,
      "controlScale": 1,
      "displayScale": 1,
      "displayLabelFamily": "Arial Black",
      "displayLabelWeight": 900,
      "displayLabelScale": 1,
      "displayValueFamily": "Microsoft Sans Serif",
      "displayValueWeight": 400,
      "displayValueScale": 1
    },
    "controls": {
      "buttonStyle": 1,
      "buttonDepth": 1,
      "roundness": 0,
      "hitboxScale": 1,
      "iconScale": 1,
      "volumeIndicatorMode": 1
    },
    "quickSearch": {
      "normalTextMode": 0,
      "customText": "#FFDCDCDC",
      "normalBackgroundMode": 1,
      "customBackground": "#FF202020",
      "borderMode": 1,
      "customBorder": "#FF051A23",
      "errorTextMode": 0,
      "customErrorText": "#FFFFE1E1",
      "errorBackgroundMode": 6,
      "customErrorBackground": "#FF581F1F",
      "fixedFontSize": 0,
      "automaticFontScale": 70
    },
    "bottomArea": {
      "backgroundMode": 3,
      "customBackground": "#FF1F313F",
      "linearGradient": true,
      "dividerMode": 4,
      "customDivider": "#FF000000",
      "sideDividers": false,
      "depth": 1,
      "quickSearchLines": 2,
      "quickSearchWidthPercent": 44
    },
    "infoStack": {
      "backgroundMode": 3,
      "customBackground": "#FF141E27",
      "fixedFontSize": 0,
      "automaticFontScale": 80,
      "tabAreaHeight": 0,
      "tabStripVisible": false,
      "tabColourMode": 1,
      "tabs": {
        "Playlists": {
          "visible": true,
          "label": "Playlists"
        },
        "Biography": {
          "visible": true,
          "label": "Bio"
        },
        "Lastfm": {
          "visible": true,
          "label": "Last.fm"
        },
        "Allmusic": {
          "visible": true,
          "label": "Notes"
        },
        "Queue": {
          "visible": true,
          "label": "Queue"
        },
        "Properties": {
          "visible": true,
          "label": "Prop"
        },
        "ThemeManager": {
          "visible": false,
          "label": "Theme"
        }
      }
    },
    "manager": {
      "fixedFontSize": 0,
      "automaticFontScale": 200
    },
    "display": {
      "accentMode": 1,
      "style": 1
    },
    "displayWaveform": {
      "backgroundMode": 6,
      "customBackground": "#FF202020"
    },
    "albumArt": {
      "backgroundMode": 2,
      "customBackground": "#FF000000",
      "aspect": 0,
      "squareSizing": 0
    },
    "layout": {
      "dividerMode": 1,
      "mainColumnsMode": 0,
      "artSpectrumMode": 0
    },
    "pages": {
      "backgroundMode": 4,
      "customBackground": "#FF141E27",
      "dynamicColours": false,
      "textMode": 0,
      "customText": "#FFDCDCDC",
      "selectedBackgroundMode": 0,
      "wallpaperMode": 0,
      "wallpaperPath": "",
      "wallpaperBlurred": false,
      "artwork": {
        "visible": true,
        "backgroundEnabled": true,
        "backgroundBlurred": true,
        "ratio": 0.5
      }
    },
    "playlistManager": {
      "colourType": "Custom",
      "text": "#FFFFFFFF",
      "background": "#FF141E27",
      "selectedBackground": "#FF124E6D",
      "showFilter": true,
      "filterWidth": 300,
      "rowHeight": 29,
      "alternatingRows": false
    },
    "playlist": {
      "colourType": "Custom",
      "text": "#FFFFFFFF",
      "highlight": "#FFFFFFFF",
      "background": "#FF141E27",
      "selectedBackground": "#FF124E6D",
      "mood": "#FFC41E23",
      "rating": "#FFDCDCDC",
      "showWallpaper": true
    }
  }
}
